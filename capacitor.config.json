{
  "appId": "com.novabrowser.app",
  "appName": "Nova Browser",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "allowNavigation": ["*"]
  },
  "server": {
    "allowNavigation": ["*"],
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a12",
      "showSpinner": false
    }
  }
}
